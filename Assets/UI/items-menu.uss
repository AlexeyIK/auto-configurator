.panel {
    background-color: rgba(206, 255, 254, 0.62);
    border-width: 2px;
    border-left-color: rgba(115, 107, 107, 0.5);
    border-right-color: rgba(115, 107, 107, 0.5);
    border-top-color: rgba(115, 107, 107, 0.8);
}

#CathegoryPanel {
    width: 300px;
    height: 100%;
    top: 0;
    right: 0;
}

#CathegoryPanel Label {
    -unity-text-align: upper-center;
}

.cathegory-list {
    flex-direction: column;
    align-items: stretch;
    align-self: center;
    padding-top: 4px;
    padding-right: 4px;
    padding-bottom: 4px;
    padding-left: 4px;
    width: 100%;
    height: 100%;
}

.cathegory-list:active {
    background-color: rgba(255, 255, 255, 0);
}

.cathegory-list .unity-list-view__item:selected {
    color: black;
    background-color: transparent;
}

.cathegory-list .unity-list-view__item:hover {
    background-color: transparent;
}

.cathegory-item {
    align-self: center;
    width: 276px;
    height: 240px;
    margin-bottom: 8px;
    padding: 2px;
    background-color: white;
    border-radius: 8px;
    border-width: 3px;
    border-color: rgba(108, 107, 107, 0.4);
}

.cathegory-item:hover {
    background-color: rgba(142, 200, 237, 0.5);
    border-width: 2px;
    border-color: rgb(142, 200, 237);
}

.list-item-selected {
    border-width: 2px;
    border-color: rgb(35, 148, 220);
}

.cathegory-image {
    flex-grow: 1;
    border-radius: 6px 6px 0 0;
}

.pieces-item {
    align-self: center;
    width: 220px;
    height: 220px;
    margin-bottom: 8px;
    padding: 2px;
    background-color: white;
    border-radius: 8px;
    border-width: 3px;
    border-color: rgba(108, 107, 107, 0.4);
}

.pieces-item:hover {
    background-color: rgba(142, 200, 237, 0.5);
    border-width: 2px;
    border-color: rgb(142, 200, 237);
}

.pieces-item-caption {
    font-size: 18px;
    -unity-text-align: middle-left;
}

.pieces-item-descr {
    font-size: 14px;
    -unity-text-align: upper-left;
}

.pieces-item-image {
    flex-grow: 1;
    flex-shrink: 0;
    width: 100%;
    border-radius: 6px 6px 0 0;
}

#PiecesPanel {
    height: 340px;
    width: 100%;
    bottom: 0;
    left: 0;
}

#PiecesPanel Label {
    -unity-text-align: upper-left;
}

.pieces-list-view {
    flex-direction: row;
    align-items: flex-start;
    padding: 4px;
    height: 100%;
    width: 100%;
    flex-shrink: 1;
    flex-grow: 0;
}

.panel-labels {
    font-size: 20px;
    -unity-font-style: bold;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 2px;
    border-left-width: 0;
    border-color: rgb(115, 115, 115);
    height: 38px;
    align-content: center;
    padding: 4px 8px;
}
