#PiecesPanel {
    height: 260px;
    width: 100%;
    bottom: 0;
    left: 0;
}

#PiecesPanel Label {
    -unity-text-align: upper-left;
}

.color-item-image {
    flex-grow: 1;
    flex-shrink: 0;
    width: 100%;
    border-radius: 6px 6px 0 0;
    -unity-background-scale-mode: cover;
    background-image: url("project://database/Assets/UI/Images/colors-blue.png?fileID=2800000&guid=d5190f1a8d3de4ef3965ec0e0cb0bc1d&type=3#colors-blue");
}

.pieces-item {
    align-self: center;
    width: 200px;
    height: 200px;
    margin-bottom: 8px;
    padding: 0;
    background-color: white;
    border-radius: 8px;
    border-width: 2px;
    border-color: rgba(108, 107, 107, 0.4);
    background-image: resource('Images/card_gradient');
}

.pieces-item:hover {
    background-color: rgba(142, 200, 237, 0.5);
    border-width: 2px;
    border-color: rgb(142, 200, 237);
}

.pieces-item-caption {
    font-size: 18px;
    -unity-text-align: middle-left;
}

.pieces-item-descr {
    font-size: 14px;
    -unity-text-align: upper-left;
}

.pieces-item-image {
    flex-grow: 1;
    flex-shrink: 0;
    width: 100%;
    border-radius: 6px 6px 0 0;
    -unity-background-scale-mode: scale-to-fit;
}

.pieces-list-view {
    flex-direction: row;
    align-items: flex-start;
    padding: 4px;
    height: 100%;
    width: 100%;
    flex-shrink: 1;
    flex-grow: 0;
}

.panel-labels {
    font-size: 20px;
    -unity-font-style: bold;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 2px;
    border-left-width: 0;
    border-color: rgb(115, 115, 115);
    height: 38px;
    align-content: center;
    padding: 4px 8px;
}