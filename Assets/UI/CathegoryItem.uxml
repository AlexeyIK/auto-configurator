<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="CathegoryItem" data-source-type="CathegoryItemData, Assembly-CSharp" class="cathegory-item" style="flex-grow: 1; background-color: rgb(210, 253, 255); border-top-left-radius: 18px; border-top-right-radius: 18px; border-bottom-right-radius: 18px; border-bottom-left-radius: 18px; background-size: 100% 100%; -unity-background-scale-mode: stretch-to-fill;">
        <ui:VisualElement name="Image" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/UI/Images/item-image.png?fileID=2800000&amp;guid=343c26b4991e84d9a956e7772fced9b6&amp;type=3#item-image&quot;); background-position-x: center 0; -unity-background-scale-mode: scale-and-crop; background-color: rgba(192, 192, 192, 0.78);">
            <Bindings>
                <ui:DataBinding property="style.backgroundImage" data-source-path="m_Image" binding-mode="ToTarget" />
            </Bindings>
        </ui:VisualElement>
        <ui:Label name="Name" text="Name" style="-unity-text-align: upper-center; font-size: 20px;">
            <Bindings>
                <ui:DataBinding property="text" data-source-path="m_Caption" binding-mode="ToTarget" />
            </Bindings>
        </ui:Label>
    </ui:VisualElement>
</ui:UXML>
