<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/common.uss?fileID=7433441132597879392&amp;guid=7d85f91042b3547958db9c63dde08734&amp;type=3#common" />
    <ui:VisualElement name="VisualElement" class="table-content" style="flex-direction: row; background-color: rgba(255, 255, 255, 0);">
        <ui:Label text="Label" data-source-type="ProjectsMenuController+ProjectItem, Assembly-CSharp" class="table-content-item table-content-item__first-child">
            <Bindings>
                <ui:DataBinding property="text" binding-mode="ToTarget" data-source-path="Name" />
            </Bindings>
        </ui:Label>
        <ui:Label text="Label" class="table-content-item">
            <Bindings>
                <ui:DataBinding property="text" data-source-path="CreatedAt" data-source-type="ProjectsMenuController+ProjectItem, Assembly-CSharp" binding-mode="ToTarget" />
            </Bindings>
        </ui:Label>
        <ui:Label text="Label" class="table-content-item">
            <Bindings>
                <ui:DataBinding property="text" data-source-path="UpdatedAt" binding-mode="ToTarget" data-source-type="ProjectsMenuController+ProjectItem, Assembly-CSharp" />
            </Bindings>
        </ui:Label>
    </ui:VisualElement>
</ui:UXML>
